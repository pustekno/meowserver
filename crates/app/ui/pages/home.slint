// Home (PRD §6.2): services, Start/Stop All, problems found by Doctor, and
// the first-run setup when nothing is installed yet (PRD §6.1).

import { Button, Switch, ScrollView } from "std-widgets.slint";
import { Backend } from "../backend.slint";
import { Card, Dot, Link, PageHeader, Theme } from "../widgets.slint";
import { ImportChoices } from "import.slint";

export component HomePage inherits VerticalLayout {
    spacing: Theme.gap;

    // Puts `text` on the clipboard through a zero-size, read-only input:
    // Slint offers copying only from a text input.
    function copy(text: string) {
        clipboard.text = text;
        clipboard.select-all();
        clipboard.copy();
        clipboard.clear-selection();
    }

    PageHeader {
        title: @tr("Home");
        subtitle: Backend.headline;
        // Zero-size, in the header row where it cannot squeeze the page.
        clipboard := TextInput {
            read-only: true;
            width: 0px;
            height: 0px;
            opacity: 0;
        }
        Button {
            text: @tr("Start All");
            primary: true;
            enabled: !Backend.busy;
            clicked => {
                Backend.start-all();
            }
        }
        Button {
            text: @tr("Stop All");
            enabled: !Backend.busy && Backend.any-running;
            clicked => {
                Backend.stop-all();
            }
        }
    }

    sv := ScrollView {
        VerticalLayout {
            width: sv.visible-width;
            spacing: Theme.gap;
            alignment: start;

            if Backend.needs-setup || Backend.setup-running: Card {
                Text {
                    text: @tr("Welcome to MeowServer");
                    font-size: 16px;
                    font-weight: 600;
                }
                Text {
                    text: Backend.mysql-downloadable
                        ? @tr("Nothing is installed yet. The recommended stack is Caddy, the newest PHP, and MySQL 8.4, downloaded from their official sources.")
                        : @tr("Nothing is installed yet. The recommended stack is Caddy and the newest PHP, downloaded from their official sources. MySQL has no download for this system yet.");
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Button {
                        text: @tr("Install recommended stack");
                        primary: true;
                        enabled: !Backend.busy;
                        clicked => {
                            Backend.quick-setup();
                        }
                    }
                }
                if Backend.importers.length > 0: Text {
                    text: @tr("Or bring your projects and databases from another app. Project folders stay where they are.");
                    color: Theme.muted;
                    wrap: word-wrap;
                }
                if Backend.importers.length > 0: ImportChoices { }
                if Backend.setup-progress != "": Text {
                    text: Backend.setup-progress;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
            }

            if Backend.import-offered && !Backend.needs-setup: Card {
                Text {
                    text: @tr("Bring your projects here");
                    font-size: 16px;
                    font-weight: 600;
                }
                Text {
                    text: @tr("This is what MeowServer would copy. Nothing changes until you press Import.");
                    color: Theme.muted;
                    wrap: word-wrap;
                }
                ImportChoices { }
            }

            Card {
                Text {
                    text: @tr("Services");
                    font-weight: 600;
                }
                for s in Backend.services: HorizontalLayout {
                    spacing: 10px;
                    min-height: 34px;
                    Dot {
                        on: s.running;
                        failed: s.failed;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: s.name;
                        vertical-alignment: center;
                        width: 120px;
                        font-weight: 500;
                    }
                    Text {
                        text: s.installed ? s.version : @tr("not installed");
                        vertical-alignment: center;
                        width: 90px;
                        color: Theme.muted;
                    }
                    // Every port it listens on, one per line as in XAMPP.
                    Text {
                        text: s.port;
                        vertical-alignment: center;
                        width: 160px;
                        color: Theme.muted;
                    }
                    Text {
                        text: s.state;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                        color: s.failed ? Theme.bad : Theme.muted;
                    }
                    Button {
                        text: "Admin";
                        visible: s.admin;
                        enabled: s.running && !Backend.busy;
                        clicked => {
                            Backend.service-admin(s.unit);
                        }
                    }
                    Switch {
                        enabled: !Backend.busy;
                        checked: s.running;
                        accessible-label: s.name;
                        toggled => {
                            Backend.toggle-unit(s.unit);
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 16px;
                    alignment: start;
                    Link {
                        text: @tr("Open localhost");
                        clicked => {
                            Backend.open-url(Backend.localhost-url);
                        }
                    }
                    Link {
                        text: @tr("Terminal");
                        clicked => {
                            Backend.open-terminal("");
                        }
                    }
                    Link {
                        text: @tr("Logs");
                        clicked => {
                            Backend.open-logs();
                        }
                    }
                }
            }

            if Backend.update-version != "": Card {
                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: @tr("MeowServer {} is available. Updating keeps your projects, databases, and settings.", Backend.update-version);
                        wrap: word-wrap;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: @tr("Update now");
                        primary: true;
                        enabled: !Backend.busy;
                        clicked => {
                            Backend.install-update();
                        }
                    }
                }
            }

            if Backend.show-share: Card {
                Text {
                    text: @tr("Like MeowServer?");
                    font-weight: 600;
                }
                Text {
                    text: @tr("Tell a friend or your team, or give it a star on GitHub. It helps other developers find it. MeowServer sends nothing about you.");
                    wrap: word-wrap;
                    color: Theme.muted;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Button {
                        text: @tr("Star on GitHub");
                        primary: true;
                        clicked => {
                            Backend.open-url("https://github.com/pustekno/meowserver");
                            Backend.share-never();
                        }
                    }
                    Button {
                        text: @tr("Copy link");
                        clicked => {
                            root.copy("https://github.com/pustekno/meowserver");
                            Backend.share-never();
                        }
                    }
                    Button {
                        text: @tr("Later");
                        clicked => {
                            Backend.share-later();
                        }
                    }
                    Button {
                        text: @tr("Don't show again");
                        clicked => {
                            Backend.share-never();
                        }
                    }
                }
            }

            if Backend.problems.length > 0: Card {
                HorizontalLayout {
                    spacing: 16px;
                    Text {
                        text: @tr("Things to check");
                        font-weight: 600;
                        horizontal-stretch: 1;
                    }
                    Link {
                        text: @tr("Copy all");
                        clicked => {
                            root.copy(Backend.problems-text);
                        }
                    }
                    Link {
                        text: @tr("Check again");
                        clicked => {
                            Backend.run-doctor();
                        }
                    }
                }
                for p in Backend.problems: HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text {
                            text: p.name + ": " + p.detail;
                            wrap: word-wrap;
                            color: Theme.bad;
                        }
                        if p.fix != "": Text {
                            text: @tr("Fix: {}", p.fix);
                            wrap: word-wrap;
                            color: Theme.muted;
                        }
                    }
                    if p.install != "": Button {
                        text: p.install-label;
                        enabled: !Backend.busy;
                        clicked => {
                            Backend.fix-need(p.install);
                        }
                    }
                    Link {
                        text: @tr("Copy");
                        clicked => {
                            root.copy(p.name + ": " + p.detail + (p.fix != "" ? "\n" + @tr("Fix: {}", p.fix) : ""));
                        }
                    }
                }
            }
        }
    }
}
