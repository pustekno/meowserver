// Databases (PRD §6.2): status, connection details, data folders.

import { Button, ScrollView } from "std-widgets.slint";
import { Backend } from "../backend.slint";
import { Card, Dot, PageHeader, Theme } from "../widgets.slint";

export component DatabasesPage inherits VerticalLayout {
    spacing: Theme.gap;

    PageHeader {
        title: @tr("Databases");
        subtitle: @tr("Reachable from this computer only. Default user without a password.");
    }


    sv := ScrollView {
        VerticalLayout {
            width: sv.visible-width;
            spacing: Theme.gap;
            alignment: start;
            for db in Backend.databases: Card {
                HorizontalLayout {
                    spacing: 10px;
                    Dot {
                        on: db.running;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: db.name + " " + db.version;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: db.running ? @tr("Stop") : @tr("Start");
                        enabled: !Backend.busy;
                        clicked => {
                            Backend.toggle-unit(db.unit);
                        }
                    }
                    Button {
                        text: @tr("Back up");
                        enabled: db.running && !Backend.busy;
                        clicked => {
                            Backend.db-backup(db.unit);
                        }
                    }
                    Button {
                        text: @tr("Open in tool");
                        enabled: db.running;
                        clicked => {
                            Backend.db-open(db.unit);
                        }
                    }
                    Button {
                        text: @tr("Data folder");
                        clicked => {
                            Backend.open-path(db.data-dir);
                        }
                    }
                }
                Text {
                    text: @tr("Host 127.0.0.1, port {}, user {}", db.port, db.user);
                    color: Theme.muted;
                }
                Text {
                    text: db.data-dir;
                    color: Theme.muted;
                    overflow: elide;
                }
            }
            if Backend.missing-databases.length > 0: Card {
                Text {
                    text: Backend.databases.length == 0 ? @tr("No database server yet. Install one:") : @tr("Install another database server:");
                    font-weight: 600;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    for choice in Backend.missing-databases: Button {
                        text: @tr("Install {}", choice.name);
                        enabled: !Backend.busy;
                        clicked => {
                            Backend.install-service(choice.id);
                        }
                    }
                }
                Text {
                    text: @tr("Other versions are on the Versions page.");
                    color: Theme.muted;
                }
            }
        }
    }
}
