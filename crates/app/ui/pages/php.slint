// PHP (PRD F20, F21): extensions and common php.ini settings.

import { Button, CheckBox, ComboBox, LineEdit, ScrollView, Switch } from "std-widgets.slint";
import { Backend } from "../backend.slint";
import { Card, PageHeader, Theme } from "../widgets.slint";

export component PhpPage inherits VerticalLayout {
    spacing: Theme.gap;

    PageHeader {
        title: @tr("PHP");
        subtitle: @tr("Settings apply to every PHP version. Other options go in etc/custom/php/.");
        ComboBox {
            width: 140px;
            model: Backend.php-versions;
            current-index <=> Backend.php-index;
            accessible-label: @tr("PHP version");
            selected => {
                Backend.select-php(self.current-index);
            }
        }
        Button {
            text: @tr("Save and apply");
            primary: true;
            enabled: !Backend.busy;
            clicked => {
                Backend.save-php();
            }
        }
    }

    sv := ScrollView {
        VerticalLayout {
            width: sv.visible-width;
            spacing: Theme.gap;
            alignment: start;
            Card {
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        Text {
                            text: @tr("Xdebug (step debugging)");
                            font-weight: 600;
                        }
                        Text {
                            text: @tr("Downloads Xdebug for each PHP version. Start a session with ?XDEBUG_TRIGGER=1 or a browser extension; your IDE listens on port 9003. Slows PHP while on.");
                            color: Theme.muted;
                            wrap: word-wrap;
                        }
                    }
                    Switch {
                        checked: Backend.xdebug;
                        enabled: !Backend.busy;
                        accessible-label: @tr("Xdebug (step debugging)");
                        toggled => {
                            Backend.set-xdebug(self.checked);
                        }
                    }
                }
            }
            Card {
                Text {
                    text: @tr("Settings");
                    font-weight: 600;
                }
                for s in Backend.ini-settings: HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: s.label;
                        vertical-alignment: center;
                        width: 220px;
                    }
                    LineEdit {
                        text: s.value;
                        accessible-label: s.label;
                        edited(text) => {
                            Backend.set-ini(s.key, text);
                        }
                    }
                }
            }
            Card {
                Text {
                    text: @tr("Extensions");
                    font-weight: 600;
                }
                if Backend.extensions.length == 0: Text {
                    text: @tr("This PHP build has its extensions compiled in.");
                    color: Theme.muted;
                }
                for e in Backend.extensions: CheckBox {
                    text: e.name;
                    checked: e.enabled;
                    toggled => {
                        Backend.toggle-extension(e.name, self.checked);
                    }
                }
            }
        }
    }
}
