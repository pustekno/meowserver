// Sites (PRD F7, F8, §6.3): every project in one list, and adding a folder
// from anywhere without shortcuts or junctions.

import { Button, ComboBox, LineEdit, ScrollView } from "std-widgets.slint";
import { Backend, SiteRow } from "../backend.slint";
import { Card, Link, PageHeader, Theme } from "../widgets.slint";

component SiteItem inherits Rectangle {
    in property <SiteRow> site;
    // A project with its own server has a folder too; a plain proxy has not.
    property <bool> has-folder: !root.site.proxy || root.site.app;
    border-radius: 6px;
    background: hover.has-hover ? Theme.card : transparent;
    hover := TouchArea { }
    // Two lines, so the controls never push the list wider than the page:
    // name and what it is above, folder and controls below.
    VerticalLayout {
        padding: 8px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 12px;
            Link {
                text: root.site.url;
                font-weight: 600;
                horizontal-stretch: 1;
                clicked => {
                    Backend.open-url(root.site.url);
                }
            }
            Text {
                text: root.site.app && root.site.runtime != "" ? (root.site.framework == "" ? root.site.runtime : root.site.framework + " · " + root.site.runtime) : root.site.framework;
                vertical-alignment: center;
                color: Theme.muted;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.site.folder;
                color: Theme.muted;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
                min-width: 80px;
            }
            if root.site.app: Button {
                text: root.site.app-running ? @tr("Stop") : @tr("Start");
                primary: !root.site.app-running;
                enabled: !Backend.busy && root.site.runtime != "";
                clicked => {
                    Backend.toggle-app(root.site.name, !root.site.app-running);
                }
            }
            if root.site.app: Button {
                text: @tr("Log");
                clicked => {
                    Backend.open-path(root.site.app-log);
                }
            }
            if !root.site.proxy: ComboBox {
                width: 100px;
                model: Backend.php-choices;
                current-index: root.site.php-index;
                accessible-label: @tr("PHP version for {}", root.site.name);
                selected(value) => {
                    Backend.set-site-php(root.site.name, value);
                }
            }
            ComboBox {
                width: 110px;
                model: [".localhost", ".test"];
                current-index: root.site.domain-index;
                accessible-label: @tr("Domain ending for {}", root.site.name);
                selected(value) => {
                    Backend.set-site-domain(root.site.name, self.current-index);
                }
            }
            Button {
                text: @tr("Folder");
                enabled: root.has-folder;
                clicked => {
                    Backend.open-path(root.site.folder);
                }
            }
            Button {
                text: @tr("Terminal");
                enabled: root.has-folder;
                clicked => {
                    Backend.open-terminal(root.site.folder);
                }
            }
            if root.site.removable: Button {
                text: @tr("Remove");
                clicked => {
                    Backend.remove-site(root.site.name);
                }
            }
        }
        if root.site.need != "": HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.site.need;
                color: Theme.accent;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if root.site.need-install != "": Button {
                text: root.site.need-install-label;
                enabled: !Backend.busy;
                clicked => {
                    Backend.fix-need(root.site.need-install);
                }
            }
        }
    }
}

export component SitesPage inherits VerticalLayout {
    spacing: Theme.gap;

    PageHeader {
        title: @tr("Sites");
        subtitle: @tr("Every folder in www/ and every added project. Folders are never changed or deleted.");
        Button {
            text: @tr("New project");
            enabled: !Backend.busy;
            clicked => {
                Backend.show-create(true);
            }
        }
        Button {
            text: @tr("Add project");
            primary: true;
            clicked => {
                Backend.pick-folder();
            }
        }
    }

    if Backend.creating: Card {
        Text {
            text: @tr("New project in www/");
            font-weight: 600;
        }
        HorizontalLayout {
            spacing: 8px;
            ComboBox {
                width: 160px;
                model: [@tr("Blank PHP"), "Laravel", "WordPress", @tr("Composer package")];
                current-index <=> Backend.template-index;
                accessible-label: @tr("Template");
            }
            LineEdit {
                horizontal-stretch: 1;
                text <=> Backend.new-name;
                placeholder-text: @tr("Site name");
                accessible-label: @tr("Site name");
            }
            if Backend.template-index == 3: LineEdit {
                width: 200px;
                text <=> Backend.new-package;
                placeholder-text: "vendor/package";
                accessible-label: @tr("Composer package");
            }
            Button {
                text: @tr("Create");
                primary: true;
                enabled: !Backend.busy && Backend.new-name != "";
                clicked => {
                    Backend.create-project();
                }
            }
            Button {
                text: @tr("Cancel");
                clicked => {
                    Backend.show-create(false);
                }
            }
        }
        if Backend.setup-progress != "": Text {
            text: Backend.setup-progress;
            color: Theme.muted;
            wrap: word-wrap;
        }
    }

    if Backend.adding: Card {
        Text {
            text: @tr("Add project");
            font-weight: 600;
        }
        Text {
            text: Backend.add-path;
            color: Theme.muted;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: 8px;
            LineEdit {
                horizontal-stretch: 1;
                text <=> Backend.add-name;
                placeholder-text: @tr("Site name");
                accessible-label: @tr("Site name");
                edited(text) => {
                    Backend.add-name-edited(text);
                }
                accepted => {
                    Backend.confirm-add();
                }
            }
            Button {
                text: @tr("Add");
                primary: true;
                enabled: Backend.add-error == "";
                clicked => {
                    Backend.confirm-add();
                }
            }
            Button {
                text: @tr("Cancel");
                clicked => {
                    Backend.cancel-add();
                }
            }
        }
        Text {
            text: Backend.add-error != "" ? Backend.add-error : Backend.add-preview;
            color: Backend.add-error != "" ? Theme.bad : Theme.muted;
        }
    }

    LineEdit {
        placeholder-text: @tr("Search by name or folder");
        accessible-label: @tr("Search sites");
        text <=> Backend.site-filter;
        edited(text) => {
            Backend.search(text);
        }
    }

    if Backend.sites.length == 0: Text {
        text: @tr("No sites yet. Create a folder in www/ or use Add project.");
        color: Theme.muted;
    }

    sv := ScrollView {
        VerticalLayout {
            width: sv.visible-width;
            alignment: start;
            for site in Backend.sites: SiteItem {
                site: site;
            }
        }
    }
}
