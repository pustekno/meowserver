// Versions (PRD F2, F3): every service in a visible list, grouped, and for
// the selected one its installed, active, and downloadable versions.

import { Button, ScrollView } from "std-widgets.slint";
import { Backend } from "../backend.slint";
import { Card, NavItem, PageHeader, Theme } from "../widgets.slint";

// A group's heading, with room above it to set the group apart.
component Group inherits VerticalLayout {
    in property <string> title;
    in property <bool> first;
    padding-top: root.first ? 0 : 12px;
    padding-bottom: 2px;
    padding-left: 12px;
    Text {
        text: root.title;
        color: Theme.muted;
        font-size: 11px;
        font-weight: 600;
    }
}

component Kind inherits NavItem {
    in property <int> index;
    height: 30px;
    label: Backend.kinds[root.index];
    active: Backend.kind-index == root.index;
    clicked => {
        Backend.kind-index = root.index;
        Backend.select-kind(root.index);
    }
}

// Indices into Backend.kinds; the order is fixed in src/main.rs (KINDS).
component KindList inherits VerticalLayout {
    spacing: 2px;
    alignment: start;
    Group {
        title: @tr("Web server");
        first: true;
    }
    for i in [1, 2, 3]: Kind {
        index: i;
    }
    Group {
        title: "PHP";
    }
    for i in [0, 10]: Kind {
        index: i;
    }
    Group {
        title: @tr("Databases");
    }
    for i in [4, 5, 6, 7]: Kind {
        index: i;
    }
    Group {
        title: @tr("Database tools");
    }
    for i in [13, 14]: Kind {
        index: i;
    }
    Group {
        title: @tr("Languages");
    }
    for i in [9, 11, 12]: Kind {
        index: i;
    }
    Group {
        title: @tr("Mail");
    }
    Kind {
        index: 8;
    }
}

export component VersionsPage inherits VerticalLayout {
    spacing: Theme.gap;

    PageHeader {
        title: @tr("Versions");
        subtitle: @tr("Downloads come from each project's official source.");
    }

    HorizontalLayout {
        spacing: 16px;

        // Scrolls when the window is shorter than the list.
        kinds := ScrollView {
            width: 180px;
            KindList {
                width: kinds.visible-width;
            }
        }

        sv := ScrollView {
            horizontal-stretch: 1;
            VerticalLayout {
                width: sv.visible-width;
                spacing: Theme.gap;
                alignment: start;
                Card {
                    Text {
                        text: Backend.kinds[Backend.kind-index];
                        font-size: 16px;
                        font-weight: 600;
                    }
                    // Web servers (indices 1-3, in Settings' order): which one serves the sites.
                    if Backend.kind-index >= 1 && Backend.kind-index <= 3: HorizontalLayout {
                        spacing: 10px;
                        if Backend.web-index == Backend.kind-index - 1: Text {
                            text: @tr("MeowServer serves your sites with this web server.");
                            color: Theme.ok;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                        if Backend.web-index != Backend.kind-index - 1: Text {
                            text: @tr("Your sites are served by {} now.", Backend.kinds[Backend.web-index + 1]);
                            color: Theme.muted;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        if Backend.web-index != Backend.kind-index - 1: Button {
                            text: @tr("Use this web server");
                            primary: Backend.installed-versions.length > 0;
                            enabled: Backend.installed-versions.length > 0 && !Backend.busy;
                            clicked => {
                                Backend.set-web(Backend.kind-index - 1);
                            }
                        }
                    }
                    Text {
                        text: @tr("Installed");
                        font-weight: 600;
                    }
                    if Backend.installed-versions.length == 0: Text {
                        text: @tr("None installed.");
                        color: Theme.muted;
                    }
                    for v in Backend.installed-versions: HorizontalLayout {
                        spacing: 10px;
                        height: 34px;
                        Text {
                            text: v.version;
                            vertical-alignment: center;
                            width: 120px;
                            font-weight: v.active ? 600 : 400;
                        }
                        if v.system-dir == "": Text {
                            text: v.active ? @tr("active") : "";
                            vertical-alignment: center;
                            color: Theme.ok;
                            horizontal-stretch: 1;
                        }
                        if v.system-dir != "": Text {
                            text: @tr("System · {}", v.system-dir);
                            vertical-alignment: center;
                            color: Theme.muted;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        if v.system-dir == "": Button {
                            text: @tr("Use");
                            enabled: !v.active && !Backend.busy;
                            clicked => {
                                Backend.use-version(v.version);
                            }
                        }
                        if v.system-dir == "": Button {
                            text: @tr("Remove");
                            enabled: !v.active && !Backend.busy;
                            clicked => {
                                Backend.uninstall-version(v.version);
                            }
                        }
                    }
                    // Languages (indices 9, 11, 12): projects can run on the system's copy.
                    if Backend.has-system-versions: Text {
                        text: Backend.kind-index == 9 || Backend.kind-index == 11 || Backend.kind-index == 12
                            ? @tr("System versions were installed outside MeowServer. Projects can run on them; MeowServer never changes or removes them.")
                            : @tr("System versions were installed outside MeowServer and are shown for reference. MeowServer runs its own copy and never changes them.");
                        color: Theme.muted;
                        wrap: word-wrap;
                    }
                }
                Card {
                    HorizontalLayout {
                        Text {
                            text: @tr("Available");
                            font-weight: 600;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Button {
                            text: Backend.loading-available ? @tr("Loading…") : @tr("Check again");
                            enabled: !Backend.loading-available;
                            clicked => {
                                Backend.load-available();
                            }
                        }
                    }
                    if Backend.loading-available && Backend.available-versions.length == 0: Text {
                        text: @tr("Loading…");
                        color: Theme.muted;
                    }
                    for v in Backend.available-versions: HorizontalLayout {
                        spacing: 10px;
                        height: 34px;
                        Text {
                            text: v.version;
                            vertical-alignment: center;
                            width: 120px;
                        }
                        Text {
                            text: v.verified ? "" : @tr("no official checksum");
                            vertical-alignment: center;
                            color: Theme.muted;
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: v.installed ? @tr("Installed") : @tr("Install");
                            enabled: !v.installed && !Backend.busy;
                            clicked => {
                                Backend.install-version(v.version);
                            }
                        }
                    }
                }
            }
        }
    }
}
