// Import from another tool (PRD F27): a button per tool found, then the
// plan to confirm. Used on Home (first run) and in Settings.

import { Button } from "std-widgets.slint";
import { Backend } from "../backend.slint";

export component ImportChoices inherits VerticalLayout {
    spacing: 8px;
    if Backend.import-plan == "": HorizontalLayout {
        spacing: 8px;
        alignment: start;
        for tool in Backend.importers: Button {
            text: @tr("Import from {}", tool.name);
            enabled: !Backend.busy;
            clicked => {
                Backend.preview-import(tool.id);
            }
        }
    }
    if Backend.import-plan != "": VerticalLayout {
        spacing: 8px;
        Text {
            text: Backend.import-plan;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            if Backend.import-blocked: Button {
                text: @tr("Stop its database");
                primary: true;
                enabled: !Backend.busy;
                clicked => {
                    Backend.stop-import-blocker();
                }
            }
            Button {
                text: @tr("Import");
                primary: !Backend.import-blocked;
                enabled: !Backend.busy && !Backend.import-blocked;
                clicked => {
                    Backend.confirm-import();
                }
            }
            Button {
                text: @tr("Cancel");
                enabled: !Backend.busy;
                clicked => {
                    Backend.cancel-import();
                }
            }
        }
    }
}
