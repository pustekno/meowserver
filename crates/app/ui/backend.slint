// Everything the pages show and every action they can take. Rust fills the
// properties and implements the callbacks (src/main.rs).

export struct ServiceRow {
    unit: string,
    name: string,
    version: string,
    port: string,
    state: string,
    running: bool,
    failed: bool,
    installed: bool,
}

export struct SiteRow {
    name: string,
    host: string,
    url: string,
    folder: string,
    php: string,
    php-index: int,
    // 0: .localhost, 1: .test
    domain-index: int,
    // What the project needs and MeowServer lacks (PRD F42), and what to
    // install for it: `php 7.4`, `postgres`, or empty.
    need: string,
    need-install: string,
    need-install-label: string,
    // A project that runs its own server: `Node.js 24`, whether it runs,
    // and its output.
    app: bool,
    runtime: string,
    app-running: bool,
    app-log: string,
    source: string,
    framework: string,
    removable: bool,
    proxy: bool,
}

export struct VersionRow {
    version: string,
    active: bool,
    installed: bool,
    verified: bool,
}

export struct CheckRow {
    name: string,
    ok: bool,
    detail: string,
    fix: string,
    // What its button installs (`php 8.4`), and the button's label.
    install: string,
    install-label: string,
}

export struct ExtRow {
    name: string,
    enabled: bool,
}

export struct SettingRow {
    key: string,
    label: string,
    value: string,
}

export struct Choice {
    id: string,
    name: string,
}

// Another installed version of a database, which can run next to the
// default one on its own port (PRD F24).
export struct DbExtra {
    line: string,
    enabled: bool,
    running: bool,
    port: string,
}

export struct DbRow {
    unit: string,
    name: string,
    version: string,
    port: string,
    running: bool,
    data-dir: string,
    user: string,
    extras: [DbExtra],
}

export global Backend {
    // Status line and errors.
    in property <string> headline;
    in property <bool> any-running;
    in property <bool> busy;
    // What the current long task is doing; shown on every page.
    in property <string> task;
    in property <bool> setup-running;
    in property <string> message;
    in property <bool> message-is-error;

    // Home.
    in property <[ServiceRow]> services;
    in property <[CheckRow]> problems;
    // The same, as text to copy.
    in property <string> problems-text;
    in property <bool> needs-setup;
    // Other tools found to import from (Laragon, XAMPP, WampServer,
    // FlyEnv), and the plan shown before anything is copied.
    in property <[Choice]> importers;
    in property <string> import-plan;
    // The tool's database server is running, so its data cannot be copied.
    in property <bool> import-blocked;
    in property <string> localhost-url;
    in property <string> setup-progress;

    // Sites.
    in property <[SiteRow]> sites;
    in property <[string]> php-choices;
    in-out property <string> site-filter;
    in property <bool> adding;
    in-out property <string> add-path;
    in-out property <string> add-name;
    in property <string> add-preview;
    in property <string> add-error;
    in property <bool> creating;
    in-out property <int> template-index;
    in-out property <string> new-name;
    in-out property <string> new-package;

    // Versions.
    in property <[string]> kinds;
    in-out property <int> kind-index;
    in property <[VersionRow]> installed-versions;
    in property <[VersionRow]> available-versions;
    in property <bool> loading-available;
    in property <string> install-progress;

    // PHP.
    in property <[string]> php-versions;
    in-out property <int> php-index;
    in property <[ExtRow]> extensions;
    in-out property <string> extension-filter;
    in property <int> extensions-enabled;
    in property <int> extensions-total;
    in property <[SettingRow]> ini-settings;

    // Databases.
    in property <[DbRow]> databases;
    // Database servers not installed yet, offered for one-click install.
    in property <[Choice]> missing-databases;

    // Settings.
    in property <int> language-index;
    in property <int> suffix-index;
    in property <int> web-index;
    in property <bool> lan-access;
    in property <bool> manage-hosts;
    in property <bool> defender-available;
    in property <bool> start-on-login;
    in property <bool> check-updates;
    in property <bool> xdebug;
    in property <bool> ca-trusted;
    in property <string> version;
    in property <string> attribution;
    in property <string> root-dir;

    callback start-all();
    callback quit-all();
    callback stop-all();
    callback toggle-unit(string);
    callback open-url(string);
    callback open-path(string);
    callback open-terminal(string);
    callback dismiss-message();

    callback quick-setup();
    callback preview-import(string);
    callback confirm-import();
    callback cancel-import();
    callback db-version(string, string, bool);
    callback stop-import-blocker();

    callback search(string);
    callback pick-folder();
    callback add-name-edited(string);
    callback confirm-add();
    callback cancel-add();
    callback remove-site(string);
    callback set-site-php(string, string);
    callback set-site-domain(string, int);
    callback toggle-app(string, bool);
    // A newer release, found by "Check for updates" or the daily check.
    in property <string> update-version;
    callback check-update();
    callback install-update();
    // The one "share MeowServer" card (PRD F46).
    in property <bool> show-share;
    callback share-later();
    callback share-never();
    // `php 7.4`, `postgres`: install; `port mysql 3306`: move a server there.
    callback fix-need(string);

    callback select-kind(int);
    callback load-available();
    callback install-version(string);
    callback use-version(string);
    callback uninstall-version(string);

    callback select-php(int);
    callback toggle-extension(string, bool);
    // Extensions from PECL not in this PHP build yet (imagick, redis, …).
    in property <[string]> pecl-extensions;
    callback install-extension(string);
    callback search-extensions(string);
    callback set-ini(string, string);
    callback save-php();

    callback set-language(int);
    callback set-suffix(int);
    callback set-web(int);
    callback set-lan(bool);
    callback set-manage-hosts(bool);
    callback defender-exclude();
    callback set-start-on-login(bool);
    callback set-check-updates(bool);
    callback set-xdebug(bool);
    callback db-backup(string);
    callback db-open(string);
    callback install-service(string);
    callback trust-ca();
    callback undo-system();
    callback show-create(bool);
    callback create-project();
    callback run-doctor();
    callback report-problem();
    callback open-logs();
}
