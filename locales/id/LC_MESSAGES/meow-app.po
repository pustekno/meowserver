msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: id\n"

msgid "Home"
msgstr "Beranda"

msgid "Sites"
msgstr "Situs"

msgid "Versions"
msgstr "Versi"

msgid "PHP"
msgstr "PHP"

msgid "Databases"
msgstr "Database"

msgid "Settings"
msgstr "Pengaturan"

msgid "Dismiss"
msgstr "Tutup"

msgid "Reachable from this computer only. Default user without a password."
msgstr "Hanya bisa diakses dari komputer ini. Pengguna bawaan tanpa password."


msgid "Stop"
msgstr "Hentikan"

msgid "Start"
msgstr "Jalankan"

msgid "Data folder"
msgstr "Folder data"

msgid "Host 127.0.0.1, port {}, user {}"
msgstr "Host 127.0.0.1, port {}, pengguna {}"

msgid "Start All"
msgstr "Jalankan Semua"

msgid "Stop All"
msgstr "Hentikan Semua"

msgid "Welcome to MeowServer"
msgstr "Selamat datang di MeowServer"

msgid "Nothing is installed yet. The recommended stack is Caddy, the newest PHP, and MySQL 8.4, downloaded from their official sources."
msgstr "Belum ada yang terpasang. Paket yang disarankan: Caddy, PHP terbaru, dan MySQL 8.4, diunduh dari sumber resminya."

msgid "Install recommended stack"
msgstr "Pasang paket yang disarankan"

msgid "Import from {}"
msgstr "Impor dari {}"

msgid "Import"
msgstr "Impor"

msgid "Or bring your projects and databases from another app. Project folders stay where they are."
msgstr "Atau bawa proyek dan database dari aplikasi lain. Folder proyek tetap di tempatnya."

msgid "Import from another app"
msgstr "Impor dari aplikasi lain"

msgid "Project folders are served where they are and databases are copied, so the other app keeps working."
msgstr "Folder proyek dilayani di tempatnya dan database disalin, jadi aplikasi lain tetap bisa dipakai."

msgid "No Laragon, XAMPP, WampServer, or FlyEnv with projects or databases was found on this computer."
msgstr "Tidak ditemukan Laragon, XAMPP, WampServer, atau FlyEnv yang berisi proyek atau database di komputer ini."

msgid "Services"
msgstr "Layanan"

msgid "not installed"
msgstr "belum terpasang"

msgid "Open localhost"
msgstr "Buka localhost"

msgid "Terminal"
msgstr "Terminal"

msgid "Logs"
msgstr "Log"

msgid "Things to check"
msgstr "Perlu diperiksa"

msgid "Check again"
msgstr "Periksa lagi"

msgid "Fix: {}"
msgstr "Solusi: {}"

msgid "Settings apply to every PHP version. Other options go in etc/custom/php/."
msgstr "Pengaturan berlaku untuk semua versi PHP. Opsi lain taruh di etc/custom/php/."

msgid "PHP version"
msgstr "Versi PHP"

msgid "Save and apply"
msgstr "Simpan dan terapkan"

msgid "Extensions"
msgstr "Ekstensi"

msgid "This PHP build has its extensions compiled in."
msgstr "Ekstensi PHP ini sudah tertanam di dalam programnya."

msgid "Language"
msgstr "Bahasa"

msgid "Web server"
msgstr "Web server"

msgid "Site names end in"
msgstr "Akhiran nama situs"

msgid ".localhost works in browsers without changing anything; .test needs hosts entries."
msgstr ".localhost langsung jalan di browser tanpa mengubah apa pun; .test butuh entri file hosts."

msgid "Write hosts entries"
msgstr "Tulis entri file hosts"

msgid "Lets PHP and Node reach your sites by name. Asks for administrator rights when sites change."
msgstr "Supaya PHP dan Node bisa memanggil situs lewat namanya. Meminta hak admin saat daftar situs berubah."

msgid "Allow access from the local network"
msgstr "Izinkan akses dari jaringan lokal"

msgid "For testing on a phone. Databases stay private."
msgstr "Untuk tes dari HP. Database tetap tertutup."

msgid "Speed up first page loads"
msgstr "Percepat pemuatan halaman pertama"

msgid "Excludes MeowServer and your project folders from Microsoft Defender scanning. Asks for administrator rights once."
msgstr "Mengecualikan folder MeowServer dan proyek dari pemindaian Microsoft Defender. Meminta hak admin sekali."

msgid "Exclude folders"
msgstr "Kecualikan folder"

msgid "Something wrong?"
msgstr "Ada masalah?"

msgid "Opens a GitHub issue filled with MeowServer's version and recent log. You review it before sending; your sites' logs are not included."
msgstr "Membuka issue GitHub berisi versi MeowServer dan log terbaru. Kamu periksa dulu sebelum mengirim; log situs-situsmu tidak ikut."

msgid "Report a problem"
msgstr "Laporkan masalah"

msgid "About"
msgstr "Tentang"

msgid "Free software under the GNU GPL 3.0 or later, with the attribution term in NOTICE. No warranty."
msgstr "Perangkat lunak bebas di bawah GNU GPL 3.0 atau lebih baru, dengan syarat atribusi di NOTICE. Tanpa jaminan."

msgid "Source code"
msgstr "Kode sumber"

msgid "PHP version for {}"
msgstr "Versi PHP untuk {}"


msgid "Folder"
msgstr "Folder"

msgid "Remove"
msgstr "Hapus"

msgid "Every folder in www/ and every added project. Folders are never changed or deleted."
msgstr "Semua folder di www/ dan semua proyek yang ditambahkan. Folder tidak pernah diubah atau dihapus."

msgid "Add project"
msgstr "Tambah proyek"

msgid "Site name"
msgstr "Nama situs"

msgid "Add"
msgstr "Tambah"

msgid "Cancel"
msgstr "Batal"

msgid "Search by name or folder"
msgstr "Cari nama atau folder"

msgid "Search sites"
msgstr "Cari situs"

msgid "No sites yet. Create a folder in www/ or use Add project."
msgstr "Belum ada situs. Buat folder di www/ atau pakai Tambah proyek."

msgid "Downloads come from each project's official source."
msgstr "Unduhan diambil dari sumber resmi masing-masing proyek."


msgid "Installed"
msgstr "Terpasang"

msgid "None installed."
msgstr "Belum ada yang terpasang."

msgid "active"
msgstr "aktif"

msgid "Use"
msgstr "Pakai"

msgid "Available"
msgstr "Tersedia"

msgid "Loading…"
msgstr "Memuat…"


msgid "no official checksum"
msgstr "tanpa checksum resmi"

msgid "Install"
msgstr "Pasang"

msgid "Start MeowServer when I log in"
msgstr "Jalankan MeowServer saat saya login"

msgid "Trust the HTTPS certificate"
msgstr "Percayai sertifikat HTTPS"

msgid "Trusted. https:// sites open without a warning."
msgstr "Sudah dipercaya. Situs https:// terbuka tanpa peringatan."

msgid "Lets https:// sites open without a warning. The certificate only works for .localhost, .test, and this computer."
msgstr "Supaya situs https:// terbuka tanpa peringatan. Sertifikat ini hanya berlaku untuk .localhost, .test, dan komputer ini."

msgid "Trusted"
msgstr "Dipercaya"

msgid "Trust"
msgstr "Percayai"

msgid "Undo system changes"
msgstr "Batalkan perubahan sistem"

msgid "Removes hosts entries, the trusted certificate, Defender exclusions, and the login item. Use before deleting the MeowServer folder."
msgstr "Menghapus entri hosts, sertifikat yang dipercaya, pengecualian Defender, dan item login. Pakai sebelum menghapus folder MeowServer."

msgid "Undo"
msgstr "Batalkan"

msgid "New project"
msgstr "Proyek baru"

msgid "New project in www/"
msgstr "Proyek baru di www/"

msgid "Blank PHP"
msgstr "PHP kosong"

msgid "Composer package"
msgstr "Paket Composer"

msgid "Template"
msgstr "Templat"

msgid "Create"
msgstr "Buat"

msgid "Xdebug (step debugging)"
msgstr "Xdebug (debugging langkah demi langkah)"

msgid "Downloads Xdebug for each PHP version. Start a session with ?XDEBUG_TRIGGER=1 or a browser extension; your IDE listens on port 9003. Slows PHP while on."
msgstr "Mengunduh Xdebug untuk setiap versi PHP. Mulai sesi dengan ?XDEBUG_TRIGGER=1 atau ekstensi browser; IDE mendengarkan di port 9003. PHP lebih lambat selama aktif."

msgid "Back up"
msgstr "Backup"

msgid "Open in tool"
msgstr "Buka di aplikasi"

msgid "Tell me about new versions"
msgstr "Beri tahu saya jika ada versi baru"

msgid "Checks GitHub once a day. Nothing is downloaded or sent."
msgstr "Mengecek GitHub sekali sehari. Tidak ada yang diunduh atau dikirim."

msgid "Working…"
msgstr "Sedang bekerja…"

msgid "Other"
msgstr "Lainnya"

msgid "No database server yet. Install one:"
msgstr "Belum ada server database. Pasang salah satu:"

