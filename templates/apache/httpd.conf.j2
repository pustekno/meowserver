# Generated by MeowServer. Do not edit: this file is rewritten on every start.
# Overrides go in {{ custom_dir | slashes }}:
#   conf/*.conf            included at the end of the main config
#   sites/<name>.conf      replaces the generated VirtualHost for that site

Define SRVROOT {{ install_dir | slashes | quote }}
ServerRoot "${SRVROOT}"
{% for addr in listen %}
Listen {{ addr }}:{{ http_port }}
{% if tls %}
Listen {{ addr }}:{{ tls.port }}
{% endif %}
{% endfor %}

{% for module in modules %}
LoadModule {{ module }}_module modules/mod_{{ module }}.so
{% endfor %}

ServerName localhost
ServerAdmin admin@localhost
PidFile {{ pid | slashes | quote }}
ErrorLog {{ error_log | slashes | quote }}
LogLevel warn
TypesConfig conf/mime.types
DirectoryIndex index.php index.html index.htm
AddDefaultCharset UTF-8
EnableSendfile off
{% if windows %}
AcceptFilter http none
AcceptFilter https none
{% endif %}
ProxyFCGIBackendType GENERIC
# Handlers below end in "/" because Apache appends the script path to the
# handler URL, and on Windows that path starts with a drive letter. The
# slash keeps the address intact; this strips it again from the path PHP
# sees ("/D:/site/index.php" -> "D:/site/index.php").
ProxyFCGISetEnvIf "reqenv('SCRIPT_FILENAME') =~ m#^/([A-Za-z]:/.*)#" SCRIPT_FILENAME "$1"
Timeout 300

<Directory />
    AllowOverride None
    Require all denied
</Directory>

<Files ".ht*">
    Require all denied
</Files>
{% for pool in pools %}

<Proxy "balancer://{{ pool.name }}/">
{% for addr in pool.upstreams %}
    BalancerMember "fcgi://{{ addr }}" retry=0
{% endfor %}
    ProxySet lbmethod=byrequests
</Proxy>
{% endfor %}

{% macro ssl_lines(tls) %}
    SSLEngine on
    SSLCertificateFile {{ tls.cert | slashes | quote }}
    SSLCertificateKeyFile {{ tls.key | slashes | quote }}
{% endmacro %}
{% macro index_vhost(port, ssl, tls, index_dir) %}
<VirtualHost *:{{ port }}>
    ServerName localhost
{% if ssl %}{{ ssl_lines(tls) }}{% endif %}
    DocumentRoot {{ index_dir | slashes | quote }}
    <Directory {{ index_dir | slashes | quote }}>
        Require all granted
    </Directory>
</VirtualHost>
{% endmacro %}
{% macro site_vhost(site, port, ssl, tls) %}
<VirtualHost *:{{ port }}>
    ServerName {{ site.host }}
{% if ssl %}{{ ssl_lines(tls) }}{% elif site.force_https %}
    Redirect permanent "/" "{{ site.https_url }}/"
{% endif %}
{% if site.proxy %}
    ProxyPreserveHost On
    ProxyPass "/" "{{ site.proxy }}/" upgrade=websocket
    ProxyPassReverse "/" "{{ site.proxy }}/"
{% else %}
    DocumentRoot {{ site.docroot | slashes | quote }}
    <Directory {{ site.docroot | slashes | quote }}>
        Options Indexes FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
{% if site.pool %}
    <FilesMatch "\.php$">
        SetHandler "proxy:balancer://{{ site.pool }}/"
    </FilesMatch>
{% endif %}
{% endif %}
</VirtualHost>
{% endmacro %}
{{ index_vhost(http_port, false, tls, index_dir) }}
{% if tls %}
{{ index_vhost(tls.port, true, tls, index_dir) }}
{% endif %}
{% for site in sites %}

{% if site.override %}
Include {{ site.override | slashes | quote }}
{% else %}
{{ site_vhost(site, http_port, false, tls) }}
{% if tls %}
{{ site_vhost(site, tls.port, true, tls) }}
{% endif %}
{% endif %}
{% endfor %}

IncludeOptional {{ (custom_dir ~ "/conf/*.conf") | slashes | quote }}
