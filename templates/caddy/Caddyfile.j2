# Generated by MeowServer. Do not edit: this file is rewritten on every start.
# Overrides go in {{ custom_dir | slashes }}:
#   global.caddy           extra global options
#   sites/<name>.caddy     replaces the generated blocks for that site

{
	admin {{ admin }}
	persist_config off
	auto_https off
	http_port {{ http_port }}
	https_port {{ https_port }}
	storage file_system {{ storage | slashes | quote }}
}
{% if global_override %}

import {{ global_override | slashes | quote }}
{% endif %}
{#- Caddy will not mix plain HTTP and a `tls` directive in one block, so
    every site is an HTTP block and an HTTPS block sharing a snippet. #}

(meow_bind) {
{% if listen %}
	bind {{ listen | join(" ") }}
{% endif %}
}
{% if tls %}

(meow_tls) {
	tls {{ tls.cert | slashes | quote }} {{ tls.key | slashes | quote }}
}
{% endif %}

(meow_index) {
	import meow_bind
	root * {{ index_dir | slashes | quote }}
	file_server
}

http://localhost, http://127.0.0.1 {
	import meow_index
}
{% if tls %}

https://localhost, https://127.0.0.1 {
	import meow_tls
	import meow_index
}
{% endif %}

# Any other name: say so instead of an empty page.
http:// {
	import meow_bind
	respond "No MeowServer site is named {host}. See http://localhost{% if http_port != 80 %}:{{ http_port }}{% endif %}/ for the list." 404
}
{% for site in sites %}

{% if site.override %}
import {{ site.override | slashes | quote }}
{% else %}
(site_{{ site.name }}) {
	import meow_bind
{% if site.proxy %}
	reverse_proxy {{ site.proxy }}
{% else %}
	root * {{ site.docroot | slashes | quote }}
{% if site.upstreams %}
	php_fastcgi {{ site.upstreams | join(" ") }} {
		lb_policy round_robin
		lb_try_duration 5s
	}
{% endif %}
	file_server
{% endif %}
}

http://{{ site.host }} {
{% if site.force_https %}
	import meow_bind
	redir {{ site.https_url }}{uri} permanent
{% else %}
	import site_{{ site.name }}
{% endif %}
}
{% if tls %}

https://{{ site.host }} {
	import meow_tls
	import site_{{ site.name }}
}
{% endif %}
{% endif %}
{% endfor %}
