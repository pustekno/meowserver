# Generated by MeowServer for {{ product }} {{ version }}. Do not edit: this
# file is rewritten on every start. Add .cnf files to {{ custom_dir | slashes }}.

[client]
port={{ port }}
host=127.0.0.1

[mysqld]
basedir={{ basedir | slashes | quote }}
datadir={{ datadir | slashes | quote }}
port={{ port }}
bind-address={{ bind }}
{% if mysqlx_off %}
mysqlx=OFF
{% endif %}
log-error={{ error_log | slashes | quote }}
pid-file={{ pid | slashes | quote }}
secure-file-priv=""
skip-log-bin
max_allowed_packet=512M
character-set-server=utf8mb4
collation-server={{ collation }}
innodb_buffer_pool_size=256M

[mysqldump]
quick
max_allowed_packet=512M

!includedir {{ custom_dir | slashes }}
