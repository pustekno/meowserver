# Generated by MeowServer. Do not edit: this file is rewritten on every start.
# Overrides go in {{ custom_dir | slashes }}:
#   http/*.conf            included inside the http block
#   sites/<name>.conf      replaces the generated server block for that site

worker_processes 1;
error_log {{ error_log | slashes | quote }} warn;
pid {{ pid | slashes | quote }};

events {
    worker_connections 1024;
}

http {
    include {{ (install_dir ~ "/conf/mime.types") | slashes | quote }};
    default_type application/octet-stream;
    sendfile on;
    keepalive_timeout 65;
    client_max_body_size 1024m;
    access_log off;
    server_names_hash_bucket_size 128;

    client_body_temp_path {{ (temp_dir ~ "/client_body") | slashes | quote }};
    proxy_temp_path {{ (temp_dir ~ "/proxy") | slashes | quote }};
    fastcgi_temp_path {{ (temp_dir ~ "/fastcgi") | slashes | quote }};
    uwsgi_temp_path {{ (temp_dir ~ "/uwsgi") | slashes | quote }};
    scgi_temp_path {{ (temp_dir ~ "/scgi") | slashes | quote }};

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }
{% for pool in pools %}

    upstream {{ pool.name }} {
{% for addr in pool.upstreams %}
        server {{ addr }} max_fails=0;
{% endfor %}
    }
{% endfor %}

{% if tls %}
    ssl_certificate {{ tls.cert | slashes | quote }};
    ssl_certificate_key {{ tls.key | slashes | quote }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:1m;

{% endif %}
    include {{ (custom_dir ~ "/http/*.conf") | slashes | quote }};

    server {
{% for addr in listen %}
        listen {{ addr }}:{{ http_port }} default_server;
{% if tls %}
        listen {{ addr }}:{{ tls.port }} ssl default_server;
{% endif %}
{% endfor %}
        server_name localhost;
        root {{ index_dir | slashes | quote }};
        index index.html;
    }
{% for site in sites %}

{% if site.override %}
    include {{ site.override | slashes | quote }};
{% else %}
    server {
{% for addr in listen %}
        listen {{ addr }}:{{ http_port }};
{% if tls %}
        listen {{ addr }}:{{ tls.port }} ssl;
{% endif %}
{% endfor %}
        server_name {{ site.host }};
{% if site.force_https %}
        if ($scheme = http) {
            return 301 {{ site.https_url }}$request_uri;
        }
{% endif %}
{% if site.proxy %}

        location / {
            proxy_pass {{ site.proxy }};
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 300;
        }
{% else %}
        root {{ site.docroot | slashes | quote }};
        index index.php index.html index.htm;

{% if site.pool %}
        location / {
            try_files $uri $uri/ /index.php$is_args$args;
        }

        location ~ \.php$ {
            try_files $uri =404;
            fastcgi_pass {{ site.pool }};
            fastcgi_index index.php;
            include {{ (install_dir ~ "/conf/fastcgi_params") | slashes | quote }};
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_next_upstream error timeout;
            fastcgi_read_timeout 300;
        }
{% else %}
        location / {
            try_files $uri $uri/ =404;
        }
{% endif %}
{% endif %}
    }
{% endif %}
{% endfor %}
}
